# Copy this file to db.properties (same folder) and put YOUR local MySQL details below.
# db.properties is listed in .gitignore, so your password is never committed.
# Alternative: set the environment variables FOTAMS_DB_URL, FOTAMS_DB_USER, FOTAMS_DB_PASSWORD.
db.url=jdbc:mysql://localhost:3306/faculty_ams?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Colombo
db.user=root
db.password=YOUR_MYSQL_PASSWORD